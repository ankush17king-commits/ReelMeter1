<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: App Title & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ReelMeter"
            android:fontFamily="sans-serif-medium"
            android:textColor="#9E9EBF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:fontFamily="sans-serif-medium"
            android:textColor="#00D4FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Section: Mascot on left, Reel count & limit on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_robot_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_robot_mascot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="🤖"
            android:textSize="52sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_total_reels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Reels"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/widget_limit_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily limit: 100"
                android:textColor="#B0B0C4"
                android:fontFamily="sans-serif"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Section: Thicker Progress Bar & App Breakdown -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#00D4FF" />

    <TextView
        android:id="@+id/widget_breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="IG: 0  •  YT: 0  •  FB: 0  •  SC: 0"
        android:fontFamily="sans-serif-medium"
        android:textColor="#8888A8"
        android:textSize="11sp" />
</LinearLayout>
